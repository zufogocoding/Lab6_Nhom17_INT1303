import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
import os
warnings.filterwarnings('ignore')
 
from sklearn.naive_bayes import GaussianNB
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import (
    classification_report, confusion_matrix,
    accuracy_score, precision_score, recall_score, f1_score
)
from imblearn.over_sampling import SMOTE
from imblearn.under_sampling import RandomUnderSampler
from imblearn.pipeline import Pipeline
from collections import Counter
 
# ✅ Tạo thư mục lưu ảnh
OUTPUT_DIR = '/kaggle/working/plots'
os.makedirs(OUTPUT_DIR, exist_ok=True)
_plot_counter = [0]
 
def savefig(name=None):
    fname = name or f'plot_{_plot_counter[0]:02d}'
    path = f'{OUTPUT_DIR}/{fname}.png'
    plt.savefig(path, dpi=150, bbox_inches='tight')
    _plot_counter[0] += 1
    print(f'✅ Đã lưu: {path}')
 
print('✅ Import xong!')


DATA_PATH = '/kaggle/input/datasets/chethuhn/network-intrusion-dataset'

csv_files = [f for f in os.listdir(DATA_PATH) if f.endswith('.csv')]
print(f'Tìm thấy {len(csv_files)} file CSV')

dfs = []
for f in csv_files:
    path = os.path.join(DATA_PATH, f)
    df_tmp = pd.read_csv(path, encoding='utf-8', low_memory=False)
    dfs.append(df_tmp)
    print(f'✅ {f}: {df_tmp.shape[0]:,} rows')

df = pd.concat(dfs, ignore_index=True)
print(f'\n✅ Tổng: {df.shape[0]:,} rows × {df.shape[1]} columns')


df.columns = df.columns.str.strip()
df.replace([np.inf, -np.inf], np.nan, inplace=True)
numeric_cols = df.select_dtypes(include=[np.number]).columns
df[numeric_cols] = df[numeric_cols].fillna(df[numeric_cols].median())

zero_var_cols = [c for c in numeric_cols if df[c].std() == 0]
df.drop(columns=zero_var_cols, inplace=True)

before = len(df)
df.drop_duplicates(inplace=True)
print(f'✅ Xóa {before - len(df):,} duplicates')

for col in df.select_dtypes(include=['int64']).columns:
    df[col] = pd.to_numeric(df[col], downcast='integer')
for col in df.select_dtypes(include=['float64']).columns:
    df[col] = df[col].astype('float32')

print(f'✅ Cleaning xong! Shape: {df.shape}')


label_counts = df['Label'].value_counts()
print(label_counts)
 
plt.figure(figsize=(14, 5))
ax = label_counts.plot(kind='bar', color='steelblue', edgecolor='black')
plt.title('Phân bố các loại Traffic')
plt.xlabel('Loại Traffic')
plt.ylabel('Số lượng')
plt.xticks(rotation=45, ha='right')
for p in ax.patches:
    ax.annotate(f'{int(p.get_height()):,}',
                (p.get_x() + p.get_width()/2, p.get_height()),
                ha='center', va='bottom', fontsize=8)
plt.tight_layout()
savefig('01_phan_bo_traffic')   # ✅ lưu ảnh
plt.show()


selected_features = [
    'Protocol', 'Flow Duration', 'Tot Fwd Pkts', 'Tot Bwd Pkts',
    'TotLen Fwd Pkts', 'TotLen Bwd Pkts', 'Fwd Pkt Len Mean',
    'Bwd Pkt Len Mean', 'Flow Byts/s', 'Flow Pkts/s',
    'Pkt Len Mean', 'Pkt Len Std', 'SYN Flag Cnt',
    'ACK Flag Cnt', 'FIN Flag Cnt', 'RST Flag Cnt',
    'PSH Flag Cnt', 'URG Flag Cnt'
]

available = [f for f in selected_features if f in df.columns]
missing   = [f for f in selected_features if f not in df.columns]
print(f'✅ Features có: {len(available)}/18')
if missing:
    print(f'⚠️ Thiếu: {missing}')

X = df[available].copy()
y = df['Label'].copy()
print(f'X: {X.shape}, y: {y.shape}')


label_encoder = LabelEncoder()
y_encoded = label_encoder.fit_transform(y)
print('Classes:', list(label_encoder.classes_))

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
print('✅ Encode + Scale xong!')


X_train, X_test, y_train, y_test = train_test_split(
    X_scaled, y_encoded, test_size=0.2, random_state=42, stratify=y_encoded
)
# Không balancing, dùng thẳng
X_train_bal = X_train
y_train_bal = y_train
print(f'Train: {X_train.shape[0]:,} | Test: {X_test.shape[0]:,}')


print('Training Naive Bayes...')
nb_model = GaussianNB(var_smoothing=1e-9)
nb_model.fit(X_train_bal, y_train_bal)
print('✅ Training xong!')


y_pred = nb_model.predict(X_test)

acc  = accuracy_score(y_test, y_pred)
prec = precision_score(y_test, y_pred, average='weighted', zero_division=0)
rec  = recall_score(y_test, y_pred, average='weighted', zero_division=0)
f1   = f1_score(y_test, y_pred, average='weighted', zero_division=0)

print('=' * 50)
print(f'  Accuracy  : {acc:.4f} ({acc*100:.2f}%)')
print(f'  Precision : {prec:.4f}')
print(f'  Recall    : {rec:.4f}')
print(f'  F1-Score  : {f1:.4f}')
print('=' * 50)
print(classification_report(y_test, y_pred,
      target_names=label_encoder.classes_, zero_division=0))


cm = confusion_matrix(y_test, y_pred)
cm_norm = cm.astype('float') / cm.sum(axis=1)[:, np.newaxis]
class_names = label_encoder.classes_

fig, axes = plt.subplots(1, 2, figsize=(20, 8))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',
            xticklabels=class_names, yticklabels=class_names, ax=axes[0])
axes[0].set_title('Confusion Matrix (Counts)')
axes[0].tick_params(axis='x', rotation=45)

sns.heatmap(cm_norm, annot=True, fmt='.2f', cmap='Oranges',
            xticklabels=class_names, yticklabels=class_names, ax=axes[1])
axes[1].set_title('Confusion Matrix (Normalized)')
axes[1].tick_params(axis='x', rotation=45)

plt.tight_layout()
savefig('02_confusion_matrix')   # ✅ lưu ảnh
plt.show()


plt.figure(figsize=(16, 12))
corr = df[available].corr()
sns.heatmap(corr, cmap='coolwarm', center=0,
            square=True, linewidths=0.5,
            annot=False, fmt='.2f')
plt.title('Correlation Heatmap - 18 Selected Features', fontsize=14)
plt.tight_layout()
savefig('03_correlation_heatmap')   
plt.show()
print('✅ Heatmap xong!')


report_dict = classification_report(
    y_test, y_pred,
    target_names=label_encoder.classes_,
    output_dict=True, zero_division=0
)
 
recall_df = pd.DataFrame({
    'Attack Type': label_encoder.classes_,
    'Recall'     : [report_dict[c]['recall']    for c in label_encoder.classes_],
    'Precision'  : [report_dict[c]['precision'] for c in label_encoder.classes_],
    'F1-Score'   : [report_dict[c]['f1-score']  for c in label_encoder.classes_],
}).sort_values('Recall', ascending=True)
 
colors = ['#e74c3c' if r < 0.7 else '#f39c12' if r < 0.9 else '#2ecc71'
          for r in recall_df['Recall']]
 
plt.figure(figsize=(12, 6))
plt.barh(recall_df['Attack Type'], recall_df['Recall'],
         color=colors, edgecolor='black')
plt.axvline(x=0.7, color='red',   linestyle='--', alpha=0.7, label='0.7 threshold')
plt.axvline(x=0.9, color='green', linestyle='--', alpha=0.7, label='0.9 threshold')
plt.xlabel('Recall Score')
plt.title('Naive Bayes — Recall per Attack Type\n(Đỏ < 0.7 = bỏ sót nhiều tấn công)', fontsize=13)
plt.legend()
plt.tight_layout()
savefig('04_recall_attack_type')   # ✅ lưu ảnh
plt.show()
 
print('\n--- Bảng tổng kết ---')
print(recall_df.to_string(index=False))
 
# ✅ Nén toàn bộ ảnh thành ZIP để tải về
import shutil
shutil.make_archive('/kaggle/working/all_plots', 'zip', OUTPUT_DIR)
print('\n✅ Tải về tại: /kaggle/working/all_plots.zip')
